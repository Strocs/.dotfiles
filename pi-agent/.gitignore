# Source only: profiles.json is the sole durable Pi configuration.
.pi/*
!.pi/gentle-ai/
.pi/gentle-ai/*
!.pi/gentle-ai/profiles.json
!.pi/agent/
.pi/agent/*
!.pi/agent/keybindings.json

# Gentle Shell uses a separate agent directory.
.gentle-shell/*
!.gentle-shell/agent/
.gentle-shell/agent/*
!.gentle-shell/agent/keybindings.json

# Runtime artifacts
.pi/agent/sessions/
.pi/agent/run-history.jsonl
.pi/agent/intercom/
.pi/agent/gentle-agents/
.pi/agent/mcp-cache.json
.pi/agent/models-store.json
.pi/agent/trust.json

# Installed extension dependencies; keep package manifests and lockfiles.
.pi/agent/npm/node_modules/
.pi/npm/node_modules/

# Pi Lens cache
.pi-lens/

# npm node_modules (managed by npm/.gitignore)

# Platform-specific binaries
.pi/agent/bin/

# API credentials (never commit)
.pi/agent/auth.json
